---
to: tests/fixtures/ggen_standing_projection.rs
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/wasm4pm-compat-pack
determinism: true
sparql:
  states: |
    PREFIX compat: <https://chatmangpt.com/ns/wasm4pm-compat#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?rank ?variant ?promotable ?terminal ?description WHERE {
      ?state a compat:StandingState ;
             compat:rank ?rank ;
             compat:rustVariant ?variant ;
             compat:promotable ?promotable ;
             compat:terminal ?terminal ;
             skos:definition ?description .
    } ORDER BY ?rank ?variant
---
// First-class Rust projection manufactured from ggen/ontology/standing-law.ttl.
// Change the canonical graph/query/template and regenerate this file together.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct StandingSpec {
    pub rank: u8,
    pub name: &'static str,
    pub promotable: bool,
    pub terminal: bool,
    pub description: &'static str,
}

pub const GGEN_STANDARD_VERSION: &str = "26.7.31";
pub const AUTHORITY: &str = "canonical_graph";
pub const PROJECTION_MODE: &str = "deterministic_committed";

pub const REQUIRED_OBLIGATIONS: &[&str] = &[
    "positive_execution",
    "negative_refusal",
    "receipt_replay",
];

pub const REFUSAL_CODES: &[&str] = &[
    "GGEN-ACTUATION-001",
    "GGEN-STANDING-001",
    "GGEN-DRIFT-001",
    "GGEN-ADMISSION-001",
];

pub const STANDING: &[StandingSpec] = &[
{% for row in states %}    StandingSpec {
        rank: {{ row.rank }},
        name: "{{ row.variant }}",
        promotable: {{ row.promotable }},
        terminal: {{ row.terminal }},
        description: "{{ row.description | replace(from="\\", to="\\\\") | replace(from="\"", to="\\\"") }}",
    },
{% endfor %}];
