---
to: src/witnesses_breeds.rs
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/wasm4pm-compat-pack
determinism: true
sparql:
  witnesses: |
    PREFIX compat: <https://wasm4pm.dev/ns#>
    SELECT ?rustType ?witnessKey ?witnessTitle ?witnessYear ?witnessFamily ?description WHERE {
      ?breed a compat:CognitionBreed ; compat:breedId ?breedId ; compat:breedLabel ?breedLabel ; compat:citation ?citation .
      BIND(CONCAT(?breedLabel, "Paper") AS ?rustType)
      BIND(CONCAT("cognition/", REPLACE(?breedId, "_", "-")) AS ?witnessKey)
      BIND(?breedLabel AS ?witnessTitle)
      BIND("Paper" AS ?witnessFamily)
      BIND(IF(STRLEN(?citation) > 120, CONCAT(SUBSTR(?citation, 1, 117), "..."), ?citation) AS ?description)
      OPTIONAL { ?breed compat:witnessYear ?witnessYear . }
    } ORDER BY ?breedId
---
//! Cognition breed witness markers — compiled from `breed-vocabulary.ttl`.
//!
//! Every entry is derived from a `compat:CognitionBreed` instance. Add or revise
//! the breed in the ontology, then run the repository ggen consumer rail.
//!
//! These are structure-only authority labels. A witness names the founding paper
//! of a cognition breed algorithm; it does not implement the algorithm. Graduate
//! to `wasm4pm` when execution is required.

use crate::witness::WitnessFamily;

{% for row in witnesses %}
witness_marker!(
    /// {{ row.description }}
    {{ row.rustType }},
    "{{ row.witnessKey }}",
    WitnessFamily::{{ row.witnessFamily }},
    "{{ row.witnessTitle }}",
    {% if row.witnessYear %}Some({{ row.witnessYear }}){% else %}None{% endif %}
);
{% endfor %}
