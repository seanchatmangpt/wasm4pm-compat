---
to: src/witnesses_rdf.rs
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/wasm4pm-compat-pack
determinism: true
sparql:
  witnesses: |
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX compat: <https://wasm4pm-compat.rs/ontology#>
    SELECT ?rustType ?witnessKey ?witnessTitle ?witnessYear ?witnessFamily ?description WHERE {
      ?marker a compat:WitnessMarker ; compat:paperCategory "rdf" ; compat:rustType ?rustType ; compat:witnessKey ?witnessKey ; compat:witnessTitle ?witnessTitle .
      OPTIONAL { ?marker compat:witnessYear ?witnessYear . }
      OPTIONAL { ?marker compat:witnessFamily ?witnessFamily . }
      OPTIONAL { ?marker compat:description ?description . }
    } ORDER BY ?rustType
---
//! RDF/SPARQL/KG witness markers — compiled from `ontology/witnesses-rdf.ttl`.
//!
//! Every entry is an ontology-derived authority label, not an RDF engine.
//! Add or revise a paper in `ontology/witnesses-rdf.ttl`, then run the
//! repository ggen consumer rail. Never patch this file alone.

use crate::witness::WitnessFamily;

{% for row in witnesses %}
witness_marker!(
    /// {{ row.description }}
    {{ row.rustType }},
    "{{ row.witnessKey }}",
    WitnessFamily::{{ row.witnessFamily | split(pat="#") | last }},
    "{{ row.witnessTitle }}",
    {% if row.witnessYear %}Some({{ row.witnessYear }}){% else %}None{% endif %}
);
{% endfor %}
