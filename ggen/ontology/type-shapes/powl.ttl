# The POWL Ontology (draft) -- a real, standards-submission-quality OWL/SHACL
# ontology for POWL (Partially Ordered Workflow Language), authored because
# a targeted search (this session's deep-research pass, wf_4abe2be2-569,
# 100 adversarially-verified sub-agents) confirmed no public RDF/OWL
# ontology for POWL exists anywhere, unlike BPMN (sBPMN) and OCEL/OCED
# (OCEDO), both reused directly in sibling files rather than redefined.
#
# Grounded in ~/POWL/powl/objects/ (a real, working reference
# implementation with its own execution engine -- phases/refusals/
# conformance/marking -- and a Lean formalization POWL.lean), not invented
# from field names alone. Modeled after OCEDO's own header shape (see
# log.ttl) as the standards-quality bar to match: dcterms metadata,
# CC-BY 4.0, a w3id.org-pattern namespace intended for registration (not
# yet registered -- this repo cannot register a w3id.org redirect on its
# own; the ontology is authored to the bar a real submission would need,
# per the user's explicit instruction, regardless of registration status).
#
# Competency questions this ontology must answer (standard ontology-
# engineering practice, matching OCEDO's own paper):
#   CQ1: What activities compose a POWL model, and which are silent (tau)?
#   CQ2: What is the partial order (precedence) between two POWL nodes?
#   CQ3: Which POWL nodes belong to a non-block-structured choice region,
#        and which are its entry/exit points?
#   CQ4: What is a node's frequency bound (min/max repetitions)?
#   CQ5: For an object-centric POWL model, which flat-model node does an
#        object-centric leaf/complex node project from, and is that
#        projection related/divergent/convergent/deficient?

@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix powl:    <https://w3id.org/powl/core#> .

<https://w3id.org/powl/core> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/powl/core/1.0.0> ;
    dcterms:title "The POWL Ontology"@en ;
    dcterms:description "An ontology describing Partially Ordered Workflow Language (POWL) process models, grounded in the ~/POWL reference implementation."@en ;
    dcterms:creator "wasm4pm-compat contributors"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    vann:preferredNamespacePrefix "powl" ;
    vann:preferredNamespaceUri "https://w3id.org/powl/core#" ;
    rdfs:comment "Draft, not yet registered on w3id.org. Authored to standards-submission quality per the OCEDO/sBPMN precedent (see log.ttl, bpmn.ttl in this same directory)."@en .

# --- classes ---------------------------------------------------------------

powl:Model a owl:Class ;
    rdfs:label "POWL Model"@en ;
    rdfs:comment "Abstract base for every node in a POWL process model: an Activity, a PartialOrder, or a ChoiceGraph. Corresponds to ~/POWL's TaggedPOWL abstract base."@en ;
    dcterms:source "powl.objects.tagged_powl.base.TaggedPOWL" .

powl:Activity a owl:Class ;
    rdfs:subClassOf powl:Model ;
    rdfs:label "Activity"@en ;
    rdfs:comment "A single labeled unit of work, or a silent (tau) step if unlabeled. Corresponds to ~/POWL's Activity."@en ;
    dcterms:source "powl.objects.tagged_powl.activity.Activity" .

powl:PartialOrder a owl:Class ;
    rdfs:subClassOf powl:Model ;
    rdfs:label "Partial Order"@en ;
    rdfs:comment "A set of POWL Models under a strict partial-order (precedence) relation. Corresponds to ~/POWL's PartialOrder."@en ;
    dcterms:source "powl.objects.tagged_powl.partial_order.PartialOrder" .

powl:ChoiceGraph a owl:Class ;
    rdfs:subClassOf powl:Model ;
    rdfs:label "Choice Graph"@en ;
    rdfs:comment "A non-block-structured decision region over a set of POWL Models, with designated entry and exit nodes. Corresponds to ~/POWL's ChoiceGraph."@en ;
    dcterms:source "powl.objects.tagged_powl.choice_graph.ChoiceGraph" .

powl:BinaryRelation a owl:Class ;
    rdfs:label "Binary Relation"@en ;
    rdfs:comment "A reusable node-set + edge-set structure over POWL Models, the shared building block PartialOrder and ChoiceGraph are backed by. Corresponds to ~/POWL's BinaryRelation."@en ;
    dcterms:source "powl.objects.BinaryRelation.BinaryRelation" .

powl:ObjectCentricNode a owl:Class ;
    rdfs:label "Object-Centric POWL Node"@en ;
    rdfs:comment "Abstract base for the object-centric projection of a flat POWL model. Corresponds to ~/POWL's ObjectCentricPOWL."@en ;
    dcterms:source "powl.objects.oc_powl.ObjectCentricPOWL" .

powl:LeafNode a owl:Class ;
    rdfs:subClassOf powl:ObjectCentricNode ;
    rdfs:label "Object-Centric Leaf Node"@en ;
    rdfs:comment "The object-centric projection of a single Activity, tagged with its relation to the object type being projected over (related/divergent/convergent/deficient). Corresponds to ~/POWL's LeafNode."@en ;
    dcterms:source "powl.objects.oc_powl.LeafNode" .

powl:ComplexModel a owl:Class ;
    rdfs:subClassOf powl:ObjectCentricNode ;
    rdfs:label "Object-Centric Complex Model"@en ;
    rdfs:comment "The object-centric projection of a PartialOrder or ChoiceGraph, carrying the per-child projection mapping. Corresponds to ~/POWL's ComplexModel."@en ;
    dcterms:source "powl.objects.oc_powl.ComplexModel" .

# --- properties on powl:Model (shared by Activity/PartialOrder/ChoiceGraph) -

powl:minFrequency a owl:DatatypeProperty ;
    rdfs:domain powl:Model ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "minimum frequency"@en ;
    rdfs:comment "Minimum number of times this model repeats. A value of 0 marks the model skippable. Default 1."@en ;
    dcterms:source "powl.objects.tagged_powl.base.TaggedPOWL.min_freq" .

powl:maxFrequency a owl:DatatypeProperty ;
    rdfs:domain powl:Model ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "maximum frequency"@en ;
    rdfs:comment "Maximum number of times this model repeats. Absent means unbounded."@en ;
    dcterms:source "powl.objects.tagged_powl.base.TaggedPOWL.max_freq" .

powl:hasAttribute a owl:ObjectProperty ;
    rdfs:domain powl:Model ; rdfs:range powl:Attribute ;
    rdfs:label "has attribute"@en ;
    dcterms:source "powl.objects.tagged_powl.base.TaggedPOWL.attributes" .

powl:Attribute a owl:Class ;
    rdfs:label "Attribute"@en ;
    rdfs:comment "A name/value pair on a POWL Model. Named-value-type here is intentionally narrowed to xsd:string, mirroring OCEDO's own KeyValue-shaped attribute pattern (see log.ttl's aux:EventAttribute) -- ~/POWL's `attributes: Mapping[str, Any]` has an open Python value type, flagged rather than silently assumed."@en .
powl:attributeKey   a owl:DatatypeProperty ; rdfs:domain powl:Attribute ; rdfs:range xsd:string .
powl:attributeValue a owl:DatatypeProperty ; rdfs:domain powl:Attribute ; rdfs:range xsd:string .

# --- properties on powl:Activity --------------------------------------------

powl:label a owl:DatatypeProperty ;
    rdfs:domain powl:Activity ; rdfs:range xsd:string ;
    rdfs:label "label"@en ;
    rdfs:comment "The activity's name. Absent means a silent (tau) activity."@en ;
    dcterms:source "powl.objects.tagged_powl.activity.Activity.label" .

powl:organization a owl:DatatypeProperty ;
    rdfs:domain powl:Activity ; rdfs:range xsd:string ;
    rdfs:label "organization"@en ;
    dcterms:source "powl.objects.tagged_powl.activity.Activity.organization" .

powl:role a owl:DatatypeProperty ;
    rdfs:domain powl:Activity ; rdfs:range xsd:string ;
    rdfs:label "role"@en ;
    dcterms:source "powl.objects.tagged_powl.activity.Activity.role" .

# --- properties on powl:PartialOrder / powl:ChoiceGraph / powl:BinaryRelation

powl:node a owl:ObjectProperty ;
    rdfs:range powl:Model ;
    rdfs:label "node"@en ;
    rdfs:comment "A POWL Model that is a member of this BinaryRelation/PartialOrder/ChoiceGraph."@en ;
    dcterms:source "powl.objects.BinaryRelation.BinaryRelation._nodes" .

powl:precedes a owl:ObjectProperty ;
    rdfs:domain powl:Model ; rdfs:range powl:Model ;
    rdfs:label "precedes"@en ;
    rdfs:comment "One POWL Model must complete before another begins, per the partial order's/choice graph's edge set. The internal networkx DiGraph in ~/POWL is a derived index over exactly this edge relation -- not separately modeled."@en ;
    dcterms:source "powl.objects.BinaryRelation.BinaryRelation._edges (semantic edge pairs, not the boolean matrix representation)" .

# --- properties on powl:LeafNode / powl:ComplexModel ------------------------

powl:projectsFrom a owl:ObjectProperty ;
    rdfs:domain powl:ObjectCentricNode ; rdfs:range powl:Model ;
    rdfs:label "projects from"@en ;
    rdfs:comment "The flat (non-object-centric) POWL Model this node is the object-centric projection of."@en ;
    dcterms:source "powl.objects.oc_powl.{LeafNode,ComplexModel}.flat_model" .

powl:activityName a owl:DatatypeProperty ;
    rdfs:domain powl:LeafNode ; rdfs:range xsd:string ;
    rdfs:comment "Defaults to the empty string when the projected activity is silent."@en ;
    dcterms:source "powl.objects.oc_powl.LeafNode.activity" .

powl:isRelated    a owl:DatatypeProperty ; rdfs:domain powl:LeafNode ; rdfs:range xsd:boolean ;
    dcterms:source "powl.objects.oc_powl.LeafNode.related" .
powl:isDivergent  a owl:DatatypeProperty ; rdfs:domain powl:LeafNode ; rdfs:range xsd:boolean ;
    dcterms:source "powl.objects.oc_powl.LeafNode.divergent" .
powl:isConvergent a owl:DatatypeProperty ; rdfs:domain powl:LeafNode ; rdfs:range xsd:boolean ;
    dcterms:source "powl.objects.oc_powl.LeafNode.convergent" .
powl:isDeficient  a owl:DatatypeProperty ; rdfs:domain powl:LeafNode ; rdfs:range xsd:boolean ;
    dcterms:source "powl.objects.oc_powl.LeafNode.deficient" .

powl:mapsChild a owl:ObjectProperty ;
    rdfs:domain powl:ComplexModel ; rdfs:range powl:ObjectCentricNode ;
    rdfs:label "maps child"@en ;
    rdfs:comment "One of this ComplexModel's flat children, mapped to its own object-centric projection. Computed once at construction from the mapping dict and the flat model's children -- treated as primary stored state per ~/POWL's own __init__, not a live-recomputed property."@en ;
    dcterms:source "powl.objects.oc_powl.ComplexModel.oc_children (computed once at construction from .mapping)" .

# --- SHACL cardinality/datatype shapes, layered on the OWL classes above ---

powl:ActivityShape a sh:NodeShape ;
    sh:targetClass powl:Activity ;
    sh:property
        [ sh:path powl:label        ; sh:datatype xsd:string  ; sh:minCount 0 ; sh:maxCount 1 ] ,
        [ sh:path powl:organization ; sh:datatype xsd:string  ; sh:minCount 0 ; sh:maxCount 1 ] ,
        [ sh:path powl:role         ; sh:datatype xsd:string  ; sh:minCount 0 ; sh:maxCount 1 ] ,
        [ sh:path powl:minFrequency ; sh:datatype xsd:nonNegativeInteger ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:maxFrequency ; sh:datatype xsd:nonNegativeInteger ; sh:minCount 0 ; sh:maxCount 1 ] .

powl:PartialOrderShape a sh:NodeShape ;
    sh:targetClass powl:PartialOrder ;
    sh:property
        [ sh:path powl:minFrequency ; sh:datatype xsd:nonNegativeInteger ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:maxFrequency ; sh:datatype xsd:nonNegativeInteger ; sh:minCount 0 ; sh:maxCount 1 ] ,
        [ sh:path powl:node ; sh:class powl:Model ; sh:minCount 0 ] ,
        [ sh:path powl:precedes ; sh:class powl:Model ; sh:minCount 0 ] .

powl:ChoiceGraphShape a sh:NodeShape ;
    sh:targetClass powl:ChoiceGraph ;
    sh:property
        [ sh:path powl:minFrequency ; sh:datatype xsd:nonNegativeInteger ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:maxFrequency ; sh:datatype xsd:nonNegativeInteger ; sh:minCount 0 ; sh:maxCount 1 ] ,
        [ sh:path powl:node ; sh:class powl:Model ; sh:minCount 0 ] ,
        [ sh:path powl:precedes ; sh:class powl:Model ; sh:minCount 0 ] .
# `_start`/`_end` internal sentinel nodes (_ChoiceGraphStart/_ChoiceGraphEnd
# in ~/POWL) are implementation plumbing for graph algorithms, not domain
# data -- not modeled as ontology individuals.

powl:LeafNodeShape a sh:NodeShape ;
    sh:targetClass powl:LeafNode ;
    sh:property
        [ sh:path powl:activityName  ; sh:datatype xsd:string  ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:projectsFrom  ; sh:class powl:Model      ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:isRelated     ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:isDivergent   ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:isConvergent  ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:isDeficient   ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] .

powl:ComplexModelShape a sh:NodeShape ;
    sh:targetClass powl:ComplexModel ;
    sh:property
        [ sh:path powl:projectsFrom ; sh:class powl:Model ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path powl:mapsChild ; sh:class powl:ObjectCentricNode ; sh:minCount 0 ] .

# `powl:ModelType` (~/POWL's ModelType Enum: ChoiceGraph/PartialOrder/
# Activity) is not separately modeled as an ontology class/individual set --
# it is redundant with `rdf:type` once powl:Activity/PartialOrder/
# ChoiceGraph exist as real OWL classes; a consumer discriminates model kind
# via rdf:type, not a parallel string field, matching standard OWL practice
# (this is the one place this ontology deliberately does NOT mirror
# ~/POWL's Python shape 1:1, because the Python shape's own reason for the
# field -- no native tagged-union/ADT in Python -- doesn't apply in OWL).
