# wasm4pm-compat -> Ash.Type projection ontology
#
# Canonical source identity remains wasm4pm-compat. Projection groups preserve
# shared morphisms while RDF Collections enumerate every admitted public value
# carrier. This graph does not recreate Rust typestate, witness, const-generic,
# admission, receipt, or execution authority.

@prefix ashbind: <https://wasm4pm-compat.rs/ash#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<https://wasm4pm-compat.rs/ash>
    a owl:Ontology ;
    rdfs:label "wasm4pm-compat Ash.Type projections" ;
    rdfs:comment "Admitted Elixir/Ash storage and casting projections of wasm4pm-compat public value carriers. Rust law remains authoritative." ;
    owl:versionInfo "26.8.7" .

ashbind:AshTypeProjectionGroup a rdfs:Class ;
    rdfs:comment "A shared lawful projection morphism applied to an RDF Collection of Rust public value carriers." .

ashbind:sourceModule a rdf:Property ; rdfs:range xsd:string .
ashbind:elixirNamespace a rdf:Property ; rdfs:range xsd:string .
ashbind:rustTypes a rdf:Property .
ashbind:subtypeOf a rdf:Property ; rdfs:range xsd:string .
ashbind:projectionClass a rdf:Property ; rdfs:range xsd:string .
ashbind:sourceFeature a rdf:Property ; rdfs:range xsd:string .
ashbind:rationale a rdf:Property ; rdfs:range xsd:string .

ashbind:Class_structural_map
    a ashbind:ProjectionClass ;
    rdfs:label "structural_map" ;
    ashbind:rationale "Structural carrier projected to Ash :map; field-level Rust law remains authoritative." .

ashbind:Class_scalar_string
    a ashbind:ProjectionClass ;
    rdfs:label "scalar_string" ;
    ashbind:rationale "Scalar text wrapper projected to Ash :string." .

ashbind:Class_enum_atom
    a ashbind:ProjectionClass ;
    rdfs:label "enum_atom" ;
    ashbind:rationale "Closed vocabulary projected to Ash :atom." .

ashbind:Class_opaque_term
    a ashbind:ProjectionClass ;
    rdfs:label "opaque_term" ;
    ashbind:rationale "Representation intentionally kept opaque as Ash :term; no stronger scalar encoding is admitted." .

ashbind:Class_scalar_integer
    a ashbind:ProjectionClass ;
    rdfs:label "scalar_integer" ;
    ashbind:rationale "Typed integer wrapper projected to Ash :integer; Rust phantom/namespace proof remains source-side." .

ashbind:Class_opaque_metric
    a ashbind:ProjectionClass ;
    rdfs:label "opaque_metric" ;
    ashbind:rationale "Compile-time bounded rational metric retained as Ash :term; numeric/storage equivalence is not asserted." .

ashbind:Class_sum_term
    a ashbind:ProjectionClass ;
    rdfs:label "sum_term" ;
    ashbind:rationale "Rust sum/payload enum retained as Ash :term until a tagged interchange representation is admitted." .

ashbind:Class_scalar_binary
    a ashbind:ProjectionClass ;
    rdfs:label "scalar_binary" ;
    ashbind:rationale "Byte-oriented wrapper projected to Ash :binary." .

ashbind:ProjectionClass a rdfs:Class .

# Fail-closed group shape: routing fields are singular and each group owns a
# non-empty RDF Collection. The Rust member names are expanded by SPARQL.
ashbind:AshTypeProjectionGroupShape
    a sh:NodeShape ;
    sh:targetClass ashbind:AshTypeProjectionGroup ;
    sh:closed false ;
    sh:property [ sh:path ashbind:sourceModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ashbind:elixirNamespace ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ashbind:rustTypes ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ashbind:subtypeOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ("map" "term" "atom" "string" "integer" "binary") ] ;
    sh:property [ sh:path ashbind:projectionClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ashbind:sourceFeature ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ashbind:Group_01
    a ashbind:AshTypeProjectionGroup ;
    ashbind:sourceModule "wasm4pm_compat::admission" ;
    ashbind:elixirNamespace "Wasm4pmCompat.AshTypes.Admission" ;
    ashbind:rustTypes ("Admission" "Refusal") ;
    ashbind:subtypeOf "map" ;
    ashbind:projectionClass "structural_map" ;
    ashbind:sourceFeature "default" .

