@prefix compat: <https://chatmangpt.com/ns/wasm4pm-compat#> .
@prefix ggen: <https://chatmangpt.com/ns/ggen#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# PUBLIC-ONTOLOGY-FIRST STANDING LAW
#
# Public vocabularies carry the semantic identity:
#   PROV-O  — the standing law is a plan with derivation identity.
#   SKOS    — standing states are concepts in one explicit concept scheme.
#   EARL    — Gall checkpoints and verification/refusal laws are test requirements.
#   DCTERMS — identifiers, descriptions, containment, dependencies, conformance.
#   SHACL   — the graph carries machine-checkable structural admission constraints.
#
# compat:/ggen: terms below are intentionally restricted to irreducible runtime
# projection metadata (rank, Rust variant, promotability, terminality) and legacy
# projection keys consumed by the current Rust verifier. They do not define the
# semantic class membership of states or checkpoints.

compat:StandingScheme
    a skos:ConceptScheme ;
    dcterms:title "wasm4pm-compat standing states" ;
    dcterms:description "Public-ontology profile for exact-tree execution standing." .

compat:StandingLaw
    a prov:Plan ;
    dcterms:title "wasm4pm-compat standing law" ;
    dcterms:conformsTo <https://github.com/seanchatmangpt/ggen/commit/68952593c40214ac1a681073d65f3902a9cdfce4> ;
    dcterms:requires compat:PositiveExecution,
                     compat:NegativeRefusal,
                     compat:ReceiptReplay ;
    dcterms:hasPart compat:GallCheckpoint01,
                    compat:GallCheckpoint02,
                    compat:GallCheckpoint03,
                    compat:GallCheckpoint04,
                    compat:GallCheckpoint05,
                    compat:GallCheckpoint06,
                    compat:GallCheckpoint07,
                    compat:GallCheckpoint08,
                    compat:GallCheckpoint09,
                    compat:GallCheckpoint10 ;
    dcterms:references compat:DirectActuation,
                       compat:SelfPromotion,
                       compat:HandEditedProjection,
                       compat:UnknownAsAdmitted ;
    prov:wasDerivedFrom <https://github.com/seanchatmangpt/ggen/commit/68952593c40214ac1a681073d65f3902a9cdfce4> ;
    # Projection metadata retained for byte-compatible Rust manufacture.
    ggen:standardVersion "26.7.31" ;
    ggen:authority "canonical_graph" ;
    ggen:projectionMode "deterministic_committed" ;
    ggen:requiresObligation compat:PositiveExecution,
                            compat:NegativeRefusal,
                            compat:ReceiptReplay ;
    ggen:requiresCheckpoint compat:GallCheckpoint01,
                            compat:GallCheckpoint02,
                            compat:GallCheckpoint03,
                            compat:GallCheckpoint04,
                            compat:GallCheckpoint05,
                            compat:GallCheckpoint06,
                            compat:GallCheckpoint07,
                            compat:GallCheckpoint08,
                            compat:GallCheckpoint09,
                            compat:GallCheckpoint10 ;
    ggen:refuses compat:DirectActuation,
                 compat:SelfPromotion,
                 compat:HandEditedProjection,
                 compat:UnknownAsAdmitted .

compat:Unknown
    a skos:Concept ;
    skos:inScheme compat:StandingScheme ;
    skos:notation "UNKNOWN" ;
    compat:rank 0 ;
    compat:rustVariant "UNKNOWN" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "Required execution evidence is absent, stale, incomplete, or bound to another tree." .

compat:Unsupported
    a skos:Concept ;
    skos:inScheme compat:StandingScheme ;
    skos:notation "UNSUPPORTED" ;
    compat:rank 1 ;
    compat:rustVariant "UNSUPPORTED" ;
    compat:promotable false ;
    compat:terminal true ;
    skos:definition "The bounded verifier does not implement the requested surface." .

compat:Blocked
    a skos:Concept ;
    skos:inScheme compat:StandingScheme ;
    skos:notation "BLOCKED" ;
    compat:rank 2 ;
    compat:rustVariant "BLOCKED" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "A required admission, tool, permission, dependency, or observation is unavailable." .

compat:BuildBroken
    a skos:Concept ;
    skos:inScheme compat:StandingScheme ;
    skos:notation "BUILD_BROKEN" ;
    compat:rank 3 ;
    compat:rustVariant "BUILD_BROKEN" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "Admitted source reached execution but compilation, tests, lint, or packaging failed." .

compat:PartialAlive
    a skos:Concept ;
    skos:inScheme compat:StandingScheme ;
    skos:notation "PARTIAL_ALIVE" ;
    compat:rank 4 ;
    compat:rustVariant "PARTIAL_ALIVE" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "A bounded checkpoint passed but the full crown is incomplete." .

compat:Alive
    a skos:Concept ;
    skos:inScheme compat:StandingScheme ;
    skos:notation "ALIVE" ;
    compat:rank 5 ;
    compat:rustVariant "ALIVE" ;
    compat:promotable true ;
    compat:terminal true ;
    skos:definition "The exact-tree external verifier admitted every positive, negative, and receipt/replay obligation." .

compat:RootCriterion
    a earl:TestCriterion ;
    dcterms:identifier "ROOT" ;
    dcterms:title "Root admission boundary" ;
    dcterms:description "Sentinel predecessor for the first Gall checkpoint; it is not itself a checkpoint." .

compat:GallCheckpoint01
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-001" ;
    dcterms:requires compat:RootCriterion ;
    dcterms:description "All canonical graph, query, template, manifest, and committed projection observations exist and are bounded." ;
    compat:rank 1 ;
    compat:rustVariant "OBSERVATION_ADMITTED" .

compat:GallCheckpoint02
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-002" ;
    dcterms:requires compat:GallCheckpoint01 ;
    dcterms:description "The canonical graph is the declared authority and the ggen standard version is exact." ;
    compat:rank 2 ;
    compat:rustVariant "AUTHORITY_BOUND" .

compat:GallCheckpoint03
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-003" ;
    dcterms:requires compat:GallCheckpoint02 ;
    dcterms:description "Every committed-output SPARQL route defines a deterministic total ordering." ;
    compat:rank 3 ;
    compat:rustVariant "ROUTE_DETERMINISTIC" .

compat:GallCheckpoint04
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-004" ;
    dcterms:requires compat:GallCheckpoint03 ;
    dcterms:description "The standing projection is complete, contiguous, uniquely named, and descriptively closed." ;
    compat:rank 4 ;
    compat:rustVariant "PROJECTION_CLOSED" .

compat:GallCheckpoint05
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-005" ;
    dcterms:requires compat:GallCheckpoint04 ;
    dcterms:description "Required refusal codes are explicit, unique, and mechanically addressable." ;
    compat:rank 5 ;
    compat:rustVariant "REFUSALS_TYPED" .

compat:GallCheckpoint06
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-006" ;
    dcterms:requires compat:GallCheckpoint05 ;
    dcterms:description "Generation is confined to first-class repository source and contains no external or developer-specific actuation path." ;
    compat:rank 6 ;
    compat:rustVariant "ACTUATION_FENCED" .

compat:GallCheckpoint07
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-007" ;
    dcterms:requires compat:GallCheckpoint06 ;
    dcterms:description "A controlled projection mutation is distinguishable and maps to a named drift refusal." ;
    compat:rank 7 ;
    compat:rustVariant "NEGATIVE_WITNESS" .

compat:GallCheckpoint08
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-008" ;
    dcterms:requires compat:GallCheckpoint07 ;
    dcterms:description "Every canonical input and committed projection is bound into the machine-readable receipt by BLAKE3 identity." ;
    compat:rank 8 ;
    compat:rustVariant "RECEIPT_BOUND" .

compat:GallCheckpoint09
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-009" ;
    dcterms:requires compat:GallCheckpoint08 ;
    dcterms:description "Repeated verification over the same admitted tree produces byte-equivalent identities and checkpoint outcomes." ;
    compat:rank 9 ;
    compat:rustVariant "REPLAY_EQUIVALENT" .

compat:GallCheckpoint10
    a earl:TestCriterion ;
    dcterms:isPartOf compat:StandingLaw ;
    dcterms:identifier "GALL-CP-010" ;
    dcterms:requires compat:GallCheckpoint09 ;
    dcterms:description "ALIVE is reachable only through an external exact-tree verifier after all lanes and all prior Gall checkpoints succeed." ;
    compat:rank 10 ;
    compat:rustVariant "CROWN_EXTERNAL" .

compat:PositiveExecution
    a earl:TestRequirement ;
    dcterms:identifier "positive_execution" ;
    dcterms:description "Observe successful execution against the exact admitted subject." .

compat:NegativeRefusal
    a earl:TestRequirement ;
    dcterms:identifier "negative_refusal" ;
    dcterms:description "Observe typed refusal for a controlled invalid or unauthorized subject." .

compat:ReceiptReplay
    a earl:TestRequirement ;
    dcterms:identifier "receipt_replay" ;
    dcterms:description "Bind execution identity into a receipt and prove deterministic replay." .

compat:DirectActuation
    a earl:TestRequirement ;
    dcterms:identifier "GGEN-ACTUATION-001" ;
    dcterms:description "Refuse direct actuation outside the admitted manufacturing boundary." .

compat:SelfPromotion
    a earl:TestRequirement ;
    dcterms:identifier "GGEN-STANDING-001" ;
    dcterms:description "Refuse self-promotion to ALIVE without the external exact-tree verifier." .

compat:HandEditedProjection
    a earl:TestRequirement ;
    dcterms:identifier "GGEN-DRIFT-001" ;
    dcterms:description "Refuse a hand-edited committed projection that diverges from deterministic manufacture." .

compat:UnknownAsAdmitted
    a earl:TestRequirement ;
    dcterms:identifier "GGEN-ADMISSION-001" ;
    dcterms:description "Refuse UNKNOWN evidence as if it were admitted execution evidence." .

# SHACL admission constraints over the public ontology spine.
compat:StandingStateShape
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:inScheme ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue compat:StandingScheme ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path skos:notation ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path compat:rank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path compat:rustVariant ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

compat:GallCheckpointShape
    a sh:NodeShape ;
    sh:targetObjectsOf dcterms:hasPart ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dcterms:requires ;
        sh:class earl:TestCriterion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path compat:rank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
