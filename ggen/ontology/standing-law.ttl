@prefix compat: <https://chatmangpt.com/ns/wasm4pm-compat#> .
@prefix ggen: <https://chatmangpt.com/ns/ggen#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

compat:StandingLaw
    a ggen:ManufacturingContract ;
    ggen:standardVersion "26.7.31" ;
    ggen:authority "canonical_graph" ;
    ggen:projectionMode "deterministic_committed" ;
    ggen:requiresObligation compat:PositiveExecution,
                            compat:NegativeRefusal,
                            compat:ReceiptReplay ;
    ggen:requiresCheckpoint compat:GallCheckpoint01,
                            compat:GallCheckpoint02,
                            compat:GallCheckpoint03,
                            compat:GallCheckpoint04,
                            compat:GallCheckpoint05,
                            compat:GallCheckpoint06,
                            compat:GallCheckpoint07,
                            compat:GallCheckpoint08,
                            compat:GallCheckpoint09,
                            compat:GallCheckpoint10 ;
    ggen:refuses compat:DirectActuation,
                 compat:SelfPromotion,
                 compat:HandEditedProjection,
                 compat:UnknownAsAdmitted ;
    prov:wasDerivedFrom <https://github.com/seanchatmangpt/ggen/commit/68952593c40214ac1a681073d65f3902a9cdfce4> .

compat:Unknown
    a compat:StandingState ;
    compat:rank 0 ;
    compat:rustVariant "UNKNOWN" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "Required execution evidence is absent, stale, incomplete, or bound to another tree." .

compat:Unsupported
    a compat:StandingState ;
    compat:rank 1 ;
    compat:rustVariant "UNSUPPORTED" ;
    compat:promotable false ;
    compat:terminal true ;
    skos:definition "The bounded verifier does not implement the requested surface." .

compat:Blocked
    a compat:StandingState ;
    compat:rank 2 ;
    compat:rustVariant "BLOCKED" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "A required admission, tool, permission, dependency, or observation is unavailable." .

compat:BuildBroken
    a compat:StandingState ;
    compat:rank 3 ;
    compat:rustVariant "BUILD_BROKEN" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "Admitted source reached execution but compilation, tests, lint, or packaging failed." .

compat:PartialAlive
    a compat:StandingState ;
    compat:rank 4 ;
    compat:rustVariant "PARTIAL_ALIVE" ;
    compat:promotable false ;
    compat:terminal false ;
    skos:definition "A bounded checkpoint passed but the full crown is incomplete." .

compat:Alive
    a compat:StandingState ;
    compat:rank 5 ;
    compat:rustVariant "ALIVE" ;
    compat:promotable true ;
    compat:terminal true ;
    skos:definition "The exact-tree external verifier admitted every positive, negative, and receipt/replay obligation." .

compat:GallCheckpoint01
    a compat:GallCheckpoint ;
    compat:rank 1 ;
    compat:code "GALL-CP-001" ;
    compat:rustVariant "OBSERVATION_ADMITTED" ;
    compat:dependsOnCode "ROOT" ;
    skos:definition "All canonical graph, query, template, manifest, and committed projection observations exist and are bounded." .

compat:GallCheckpoint02
    a compat:GallCheckpoint ;
    compat:rank 2 ;
    compat:code "GALL-CP-002" ;
    compat:rustVariant "AUTHORITY_BOUND" ;
    compat:dependsOnCode "GALL-CP-001" ;
    skos:definition "The canonical graph is the declared authority and the ggen standard version is exact." .

compat:GallCheckpoint03
    a compat:GallCheckpoint ;
    compat:rank 3 ;
    compat:code "GALL-CP-003" ;
    compat:rustVariant "ROUTE_DETERMINISTIC" ;
    compat:dependsOnCode "GALL-CP-002" ;
    skos:definition "Every committed-output SPARQL route defines a deterministic total ordering." .

compat:GallCheckpoint04
    a compat:GallCheckpoint ;
    compat:rank 4 ;
    compat:code "GALL-CP-004" ;
    compat:rustVariant "PROJECTION_CLOSED" ;
    compat:dependsOnCode "GALL-CP-003" ;
    skos:definition "The standing projection is complete, contiguous, uniquely named, and descriptively closed." .

compat:GallCheckpoint05
    a compat:GallCheckpoint ;
    compat:rank 5 ;
    compat:code "GALL-CP-005" ;
    compat:rustVariant "REFUSALS_TYPED" ;
    compat:dependsOnCode "GALL-CP-004" ;
    skos:definition "Required refusal codes are explicit, unique, and mechanically addressable." .

compat:GallCheckpoint06
    a compat:GallCheckpoint ;
    compat:rank 6 ;
    compat:code "GALL-CP-006" ;
    compat:rustVariant "ACTUATION_FENCED" ;
    compat:dependsOnCode "GALL-CP-005" ;
    skos:definition "Generation is confined to first-class repository source and contains no external or developer-specific actuation path." .

compat:GallCheckpoint07
    a compat:GallCheckpoint ;
    compat:rank 7 ;
    compat:code "GALL-CP-007" ;
    compat:rustVariant "NEGATIVE_WITNESS" ;
    compat:dependsOnCode "GALL-CP-006" ;
    skos:definition "A controlled projection mutation is distinguishable and maps to a named drift refusal." .

compat:GallCheckpoint08
    a compat:GallCheckpoint ;
    compat:rank 8 ;
    compat:code "GALL-CP-008" ;
    compat:rustVariant "RECEIPT_BOUND" ;
    compat:dependsOnCode "GALL-CP-007" ;
    skos:definition "Every canonical input and committed projection is bound into the machine-readable receipt by BLAKE3 identity." .

compat:GallCheckpoint09
    a compat:GallCheckpoint ;
    compat:rank 9 ;
    compat:code "GALL-CP-009" ;
    compat:rustVariant "REPLAY_EQUIVALENT" ;
    compat:dependsOnCode "GALL-CP-008" ;
    skos:definition "Repeated verification over the same admitted tree produces byte-equivalent identities and checkpoint outcomes." .

compat:GallCheckpoint10
    a compat:GallCheckpoint ;
    compat:rank 10 ;
    compat:code "GALL-CP-010" ;
    compat:rustVariant "CROWN_EXTERNAL" ;
    compat:dependsOnCode "GALL-CP-009" ;
    skos:definition "ALIVE is reachable only through an external exact-tree verifier after all lanes and all prior Gall checkpoints succeed." .

compat:PositiveExecution a compat:VerificationObligation ; compat:code "positive_execution" .
compat:NegativeRefusal a compat:VerificationObligation ; compat:code "negative_refusal" .
compat:ReceiptReplay a compat:VerificationObligation ; compat:code "receipt_replay" .

compat:DirectActuation a compat:RefusalLaw ; compat:code "GGEN-ACTUATION-001" .
compat:SelfPromotion a compat:RefusalLaw ; compat:code "GGEN-STANDING-001" .
compat:HandEditedProjection a compat:RefusalLaw ; compat:code "GGEN-DRIFT-001" .
compat:UnknownAsAdmitted a compat:RefusalLaw ; compat:code "GGEN-ADMISSION-001" .
