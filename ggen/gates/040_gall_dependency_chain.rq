# MESSAGE: every Gall checkpoint must name its exact predecessor code
PREFIX compat: <https://chatmangpt.com/ns/wasm4pm-compat#>
SELECT ?checkpoint ?rank ?observed ?expected WHERE {
  VALUES (?rank ?expected) {
    (1 "ROOT")
    (2 "GALL-CP-001")
    (3 "GALL-CP-002")
    (4 "GALL-CP-003")
    (5 "GALL-CP-004")
    (6 "GALL-CP-005")
    (7 "GALL-CP-006")
    (8 "GALL-CP-007")
    (9 "GALL-CP-008")
    (10 "GALL-CP-009")
  }
  ?checkpoint a compat:GallCheckpoint ; compat:rank ?rank .
  OPTIONAL { ?checkpoint compat:dependsOnCode ?observed . }
  FILTER(!BOUND(?observed) || ?observed != ?expected)
}
ORDER BY ?rank ?checkpoint
