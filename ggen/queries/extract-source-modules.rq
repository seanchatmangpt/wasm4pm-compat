# SPARQL Query: Extract Source Modules from wasm4pm-compat ontology
# Purpose: Enumerate all canon modules with their Rust types, source paths, and graduation flags
# Usage: ggen query extract-source-modules.rq --format json
#
# 2026-11-04 (SA-12): GROUP_CONCAT ?laws aggregate removed. GROUP_CONCAT is
# broken on ggen 26.10.11 (its column silently drops — run-ggen skill, Gotchas)
# and the ontology carries zero compat:satisfiesLaw instance data, so ?laws was
# dead plumbing. The template's per-law fixture check therefore always took its
# empty branch; see audit-script.tera CHECK 4. If per-law checks are ever
# needed, extract laws as separate rows and loop in Tera instead.

PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX compat: <https://wasm4pm-compat.rs/ontology#>

SELECT ?moduleName ?rustType ?sourceFile ?graduatesToWasm4pm
WHERE {
  ?module a compat:SourceModule ;
          compat:moduleName ?moduleName ;
          compat:sourceFile ?sourceFile .

  OPTIONAL { ?module compat:rustType ?rustType . }
  OPTIONAL { ?module compat:graduatesToWasm4pm ?graduatesToWasm4pm . }
}
ORDER BY ?moduleName
