PREFIX compat: <https://chatmangpt.com/ns/wasm4pm-compat#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?rank ?code ?variant ?depends_on ?description
WHERE {
  ?checkpoint a compat:GallCheckpoint ;
              compat:rank ?rank ;
              compat:code ?code ;
              compat:rustVariant ?variant ;
              compat:dependsOnCode ?depends_on ;
              skos:definition ?description .
}
ORDER BY ?rank ?code
