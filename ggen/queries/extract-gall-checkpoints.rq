PREFIX compat: <https://chatmangpt.com/ns/wasm4pm-compat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX earl: <http://www.w3.org/ns/earl#>

SELECT ?rank ?code ?variant ?depends_on ?description
WHERE {
  ?checkpoint a earl:TestCriterion ;
              dcterms:isPartOf compat:StandingLaw ;
              dcterms:identifier ?code ;
              dcterms:requires ?dependency ;
              dcterms:description ?description ;
              compat:rank ?rank ;
              compat:rustVariant ?variant .
  ?dependency dcterms:identifier ?depends_on .
}
ORDER BY ?rank ?code
