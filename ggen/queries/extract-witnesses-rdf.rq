PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX compat: <https://wasm4pm-compat.rs/ontology#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?rustType ?witnessKey ?witnessTitle ?witnessYear ?witnessFamily ?description
       ?categoryId ?categoryLabel ?sourceTtl
WHERE {
  ?marker a compat:WitnessMarker ;
          compat:paperCategory "rdf" ;
          compat:rustType     ?rustType ;
          compat:witnessKey   ?witnessKey ;
          compat:witnessTitle ?witnessTitle .

  # OPTIONAL columns re-bound via COALESCE: every row must bind every column
  # (ggen 26.10.11 fills unbound columns silently from the previous row).
  OPTIONAL { ?marker compat:witnessYear   ?yearRaw }
  OPTIONAL { ?marker compat:witnessFamily ?familyRaw }
  OPTIONAL { ?marker compat:description  ?descriptionRaw }
  BIND(COALESCE(?yearRaw, "") AS ?witnessYear)
  BIND(COALESCE(?familyRaw, "") AS ?witnessFamily)
  BIND(COALESCE(?descriptionRaw, "") AS ?description)

  BIND("rdf" AS ?categoryId)
  BIND("RDF/SPARQL/KG" AS ?categoryLabel)
  BIND("ontology/witnesses-rdf.ttl" AS ?sourceTtl)
}
ORDER BY ?rustType
