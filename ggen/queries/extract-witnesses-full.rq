# SPARQL Query: Extract all WitnessMarker instances with full template-compatible bindings
# Variable names match witness-marker.tera exactly.

PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-syntax-ns#>
PREFIX compat: <https://wasm4pm-compat.rs/ontology#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?rustType ?witnessKey ?witnessTitle ?witnessYear ?witnessFamily ?paperReference ?description
WHERE {
  ?marker a compat:WitnessMarker ;
          compat:rustType     ?rustType ;
          compat:witnessKey   ?witnessKey ;
          compat:witnessTitle ?witnessTitle .

  # Exclude per-category witnesses — those are rendered into witnesses_<category>.rs modules.
  FILTER NOT EXISTS { ?marker compat:paperCategory ?_cat . }

  # OPTIONAL columns are re-bound via COALESCE below so EVERY row binds EVERY
  # column explicitly. ggen 26.10.11 fills unbound columns forward from the
  # previous row (silent wrong values) — never leave a template-consumed column
  # partially bound. See run-ggen skill, Gotchas note 3.
  OPTIONAL { ?marker compat:witnessYear    ?yearRaw . }
  OPTIONAL { ?marker compat:witnessFamily  ?familyRaw . }
  OPTIONAL { ?marker compat:paperReference ?paperReferenceRaw . }
  OPTIONAL { ?marker compat:description   ?descriptionRaw . }
  BIND(COALESCE(?yearRaw, "") AS ?witnessYear)
  BIND(COALESCE(?familyRaw, "") AS ?witnessFamily)
  BIND(COALESCE(?paperReferenceRaw, "") AS ?paperReference)
  BIND(COALESCE(?descriptionRaw, "") AS ?description)
}
ORDER BY ?rustType
